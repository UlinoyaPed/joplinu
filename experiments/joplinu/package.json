{
	"name": "joplinu-prototype",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"license": "AGPL-3.0-or-later",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "vite --host 0.0.0.0",
		"build": "npm run typecheck && vite build",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:browser": "playwright test",
		"test:production": "playwright test --config playwright.production.config.ts",
		"check": "npm run build && npm test && npm run test:browser && npm run test:production"
	},
	"engines": {
		"node": ">=22.19"
	},
	"dependencies": {
		"@codemirror/commands": "^6.10.0",
		"@codemirror/lang-markdown": "^6.5.0",
		"@codemirror/language": "^6.12.0",
		"@codemirror/search": "^6.5.0",
		"@codemirror/state": "^6.5.0",
		"@codemirror/view": "^6.38.0",
		"@lezer/highlight": "^1.2.0",
		"@lezer/markdown": "^1.4.0",
		"diff": "^8.0.4",
		"katex": "^0.19.0",
		"prosemirror-commands": "^1.7.0",
		"prosemirror-keymap": "^1.2.3",
		"prosemirror-markdown": "^1.13.2",
		"prosemirror-model": "^1.25.0",
		"prosemirror-schema-list": "^1.5.1",
		"prosemirror-state": "^1.4.3",
		"prosemirror-tables": "^1.7.1",
		"prosemirror-view": "^1.40.0",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"rehype-katex": "^7.0.1",
		"rehype-sanitize": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-gfm": "^4.0.1",
		"remark-math": "^6.0.0",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.0.0",
		"y-codemirror.next": "^0.3.5",
		"yjs": "^13.6.27"
	},
	"overrides": {
		"katex": "$katex"
	},
	"devDependencies": {
		"@playwright/test": "^1.55.0",
		"@types/katex": "^0.16.7",
		"@types/mdast": "^4.0.4",
		"@types/node": "^24.0.0",
		"@types/react": "^19.1.0",
		"@types/react-dom": "^19.1.0",
		"@vitejs/plugin-react": "^5.0.0",
		"typescript": "^5.9.3",
		"vite": "^7.1.0",
		"vitest": "^5.0.5"
	}
}
