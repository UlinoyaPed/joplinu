{
	"name": "joplinu-prototype",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"license": "AGPL-3.0-or-later",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "vite --host 0.0.0.0",
		"build": "npm run typecheck && vite build",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:browser": "playwright test",
		"test:production": "playwright test --config playwright.production.config.ts",
		"check": "npm run build && npm test && npm run test:packaging && npm run test:browser && npm run test:production",
		"build:rpm": "npm run desktop:package && node scripts/collect-rpm.mjs",
		"android:sync": "npm exec --workspace @joplinu/android -- cap sync android",
		"android:assemble": "cd apps/android/native && ./gradlew :app:assembleDebug :app:assembleRelease :app:lintDebug --no-daemon",
		"build:apk": "npm run build && npm run android:sync && npm run android:assemble && node scripts/collect-android.mjs",
		"test:packaging": "node --test scripts/*.test.mjs",
		"test:desktop": "node scripts/desktop-smoke.mjs",
		"prebuild": "node scripts/notices.mjs && node scripts/build-desktop-cloud.mjs",
		"desktop:package": "npm run build && electron-builder --config electron-builder.config.cjs --linux rpm --x64 --publish never",
		"android:test": "cd apps/android/native && ./gradlew :app:connectedDebugAndroidTest --no-daemon",
		"storage:setup": "node --use-env-proxy scripts/fetch-seaweed.mjs",
		"test:storage:s3": "vitest run --config vitest.storage.config.ts tests/integration/s3.test.ts",
		"test:storage:oss": "vitest run --config vitest.storage.config.ts tests/integration/oss.test.ts"
	},
	"engines": {
		"node": ">=22.19"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1156.0",
		"@capacitor/core": "8.5.3",
		"@capacitor/filesystem": "8.1.5",
		"@capacitor/share": "8.0.3",
		"@codemirror/commands": "^6.10.0",
		"@codemirror/lang-markdown": "^6.5.0",
		"@codemirror/language": "^6.12.0",
		"@codemirror/search": "^6.5.0",
		"@codemirror/state": "^6.5.0",
		"@codemirror/view": "^6.38.0",
		"@lezer/highlight": "^1.2.0",
		"@lezer/markdown": "^1.4.0",
		"ali-oss": "^6.23.0",
		"diff": "^8.0.4",
		"dompurify": "^3.4.17",
		"fflate": "^0.8.3",
		"katex": "^0.19.0",
		"mermaid": "^12.2.0",
		"prosemirror-commands": "^1.7.0",
		"prosemirror-keymap": "^1.2.3",
		"prosemirror-markdown": "^1.13.2",
		"prosemirror-model": "^1.25.0",
		"prosemirror-schema-list": "^1.5.1",
		"prosemirror-state": "^1.4.3",
		"prosemirror-tables": "^1.7.1",
		"prosemirror-view": "^1.40.0",
		"proxy-agent": "6.5.0",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"rehype-katex": "^7.0.1",
		"rehype-sanitize": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-gfm": "^4.0.1",
		"remark-math": "^6.0.0",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"shiki": "^4.5.0",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.0.0",
		"y-codemirror.next": "^0.3.5",
		"yjs": "^13.6.27"
	},
	"overrides": {
		"katex": "$katex",
		"@electron/get": "5.1.0",
		"uuid": "11.1.1"
	},
	"devDependencies": {
		"@capacitor/cli": "^8.5.3",
		"@playwright/test": "^1.55.0",
		"@types/ali-oss": "^6.23.4",
		"@types/katex": "^0.16.7",
		"@types/mdast": "^4.0.4",
		"@types/node": "^24.0.0",
		"@types/react": "^19.1.0",
		"@types/react-dom": "^19.1.0",
		"@vitejs/plugin-react": "^5.0.0",
		"electron": "^45.0.0",
		"electron-builder": "^26.15.3",
		"esbuild": "0.28.2",
		"typescript": "^5.9.3",
		"vite": "^7.1.0",
		"vitest": "^5.0.5"
	}
}
